# GPIO43/44 (this NFC module's UART pins, see board_config.h) are the
# ESP32-S3's own hardwired U0TXD/U0RXD — i.e. UART0, the default app
# console. With the default console config, the ESP32 continuously drives
# its own log output onto GPIO43, straight into the NFC module's RX pin,
# while also fighting it for GPIO44 — a standing conflict that would
# explain the module staying totally silent regardless of baud/voltage.
# The platformio monitor keeps working unaffected: it reads the *secondary*
# console channel (USB_SERIAL_JTAG, separate physical pins from UART0's),
# which is what /dev/cu.usbmodem101 actually is. This frees GPIO43/44 for
# exclusive NFC use (aside from the chip's own unavoidable, one-time,
# sub-second ROM boot-log burst on every power-on/reset, which isn't
# config-controlled at all).
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# Strips the compile timestamp (the only non-deterministic input for a
# fixed commit + pinned toolchain) so a released binary can be verified
# as genuinely built from the commit it claims — see the README's
# "Verifying a release" section.
CONFIG_APP_REPRODUCIBLE_BUILD=y

# ESP32-S3R8 module: 16MB flash, 8MB Octal PSRAM.
# Verified-working block, carried over as-is from the sibling Grill & Groove
# project (/Users/ESP32MusicAndMeat) which runs the same ESP32-S3R8 chip.
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y

CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_BOOT_INIT=y
CONFIG_SPIRAM_IGNORE_NOTFOUND=n
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=0
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y

# LVGL fonts actually used by this project's UI (ui_boot.c, main.c)
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_48=y

# Spinner widget — used as the "whirlygig" loading indicator while new
# album art is downloading after a good NFC tap (main.c).
CONFIG_LV_USE_SPINNER=y

# QR code widget — the setup wizard's "scan to join" code on the Setup
# screen (main.c, setup_portal.c).
CONFIG_LV_USE_QRCODE=y

# esp_http_server's default 512-byte header budget is too tight for a
# real phone browser's captive-portal request — modern mobile Safari/
# Chrome send a full set of Accept/Accept-Language/Sec-Fetch-*/User-Agent
# headers that routinely add up past that, rejected outright as
# "431 Request Header Fields Too Large" (setup_portal.c).
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024
CONFIG_HTTPD_MAX_URI_LEN=1024

# Must match album_art.c's RGB565 buffers (uint16_t pixels).
CONFIG_LV_COLOR_DEPTH_16=y

# RGB565 byte order between LVGL's buffer and the QSPI panel.
CONFIG_LV_COLOR_16_SWAP=y

# TJpgDec (tjpgd.h) — the JPEG decoder album_art.c uses lives inside this
# LVGL module; without it the header's declarations compile out entirely.
CONFIG_LV_USE_SJPG=y

# ESP-IDF's default "main" task stack (3584 B) isn't enough for our boot
# sequence (WiFi init, display/LVGL bring-up, SSDP discovery's 1KB+ stack
# buffers) — it stack-overflowed partway through esp_wifi_init() on first
# boot. Same value the sibling Grill & Groove project uses.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# Mozilla CA bundle, for esp_crt_bundle_attach() — album art is fetched
# over HTTPS from CDNs (e.g. Spotify's), see album_art.c.
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y

# Measured directly: curl from a Mac on the same WiFi gets these exact
# Spotify CDN files in 2-3s / 35-100 KB/s; the ESP32 took 9-51s or failed
# outright, ruling out the network/CDN entirely. Default mbedTLS config
# allocates every TLS connection's buffers (16KB in + 4KB out) from
# internal DRAM — the same scarce pool WiFi's own DMA buffers need, and a
# well-documented ESP32 contention point under concurrent network load.
# Switched from EXTERNAL_MEM_ALLOC to DEFAULT_MEM_ALLOC: the sibling
# Grill & Groove project (same ESP32-S3R8 chip, same ESP-IDF 5.3.1) uses
# DEFAULT, not EXTERNAL — forcing *everything* mbedTLS touches into PSRAM
# (EXTERNAL) adds real latency to the many small/frequent allocations
# crypto makes internally; DEFAULT lets ESP-IDF's normal allocator send
# only the large I/O buffers to PSRAM while small hot-path ones stay in
# fast internal SRAM. Confirmed via their own comment: this is what fixed
# MBEDTLS_ERR_SSL_ALLOC_FAILED for them without the EXTERNAL-mode downside.
CONFIG_MBEDTLS_DEFAULT_MEM_ALLOC=y

# Matches the sibling project's socket headroom.
CONFIG_LWIP_MAX_SOCKETS=14

# Tried bumping TCP receive window (65535, then a more conservative
# 16384) to fix slow album art downloads — BOTH made things worse, not
# better. That rules out TCP window size as the bottleneck entirely
# (not just "needed tuning") — reverted to the ESP-IDF default (5760).

# Per-chunk timing logs show data arriving in instant ~16KB bursts
# separated by multi-second gaps that roughly double each time (1s, 2s,
# 3s, 4s, 6s, 8s, 12s...) — the textbook signature of TCP retransmission
# timeout backoff after packet loss, not a throughput ceiling. Enabling
# LWIP's own TCP stats (rexmit/drop counters) to confirm with hard
# numbers instead of inferring from timing alone — see album_art.c.
CONFIG_LWIP_STATS=y
